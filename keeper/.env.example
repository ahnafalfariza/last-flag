# Config for the hosted keeper and bots. Copy to keeper/.env for Docker Compose or pm2.
# keeper/.env is git-ignored. Never commit real keys.
#
# On a container host (Fly.io, Railway, Render, ...) don't upload this file: put KEEPER_KEY and
# BOTS in the host's secret store and the rest in its plain env vars.
#
# Placeholders only. Use throwaway testnet accounts that hold just enough NEAR for gas and bids.

# testnet | mainnet | sandbox
NEAR_NETWORK=testnet

# Optional. Defaults: https://test.rpc.fastnear.com (testnet), https://rpc.mainnet.fastnear.com (mainnet).
# A local sandbox seen from a container: http://host.docker.internal:3030
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# The deployed game contract.
LASTFLAG_CONTRACT=lastflag.example.testnet

# --- keeper ---
# The account that calls tick() and earns the keeper reward. Needs a little NEAR for gas.
KEEPER_ACCOUNT=keeper.example.testnet
# Its full-access or function-call private key. SECRET.
KEEPER_KEY=ed25519:REPLACE_WITH_KEEPER_PRIVATE_KEY
# Optional. Poll interval while the storm is up, ms (default 1100, about one block).
# KEEPER_INTERVAL_MS=1100

# --- bots ---
# JSON array of {account, key}, on one line, in single quotes. SECRET.
# `pnpm bots setup` (run locally, with FUNDER_ACCOUNT set) creates the accounts and writes this
# array to keeper/.bots.testnet.json; paste the file's content here, joined onto one line.
BOTS='[{"account":"whale.example.testnet","key":"ed25519:REPLACE"},{"account":"sniper.example.testnet","key":"ed25519:REPLACE"},{"account":"dibs.example.testnet","key":"ed25519:REPLACE"}]'
# Optional. Hold each round open this many minutes, then stop bidding so the storm ends it.
# Needs a contract with a long grace_ms (minutes, not seconds). Default: unpaced, short rounds.
# BOT_ROUND_MINUTES=55

# --- both ---
# Optional. How often each process logs an "alive:" line, ms (default 60000).
# HEARTBEAT_MS=60000
