{
  "name": "lastflag-keeper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "pnpm wasm:game && pnpm wasm:vanisher",
    "wasm:game": "RUSTFLAGS='--cfg near' cargo build --manifest-path ../contracts/lastflag/Cargo.toml --target wasm32-unknown-unknown --release --target-dir ../contracts/lastflag/target/near-cfg",
    "wasm:vanisher": "RUSTFLAGS='--cfg near' cargo build --manifest-path ../contracts/vanisher/Cargo.toml --target wasm32-unknown-unknown --release --target-dir ../contracts/vanisher/target/near-cfg",
    "sandbox": "node src/sandbox.ts",
    "keeper": "node src/keeper.ts",
    "bots": "node src/bots.ts",
    "deploy-game": "node src/deploy.ts",
    "e2e": "node --test src/e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "near-sandbox": "0.3.5",
    "typescript": "~7.0.2"
  }
}
